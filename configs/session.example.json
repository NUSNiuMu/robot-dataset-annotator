{
  "schema_version": 1,
  "workspace": "REPLACE_WITH_CONFIRMED_WORKSPACE",
  "input_root": "REPLACE_WITH_CONFIRMED_RECORDING_ROOT",
  "review_root": "REPLACE_WITH_CONFIRMED_REVIEW_ROOT",
  "dataset_root": "REPLACE_WITH_CONFIRMED_DATASET_ROOT",
  "task_spec": "REPLACE_WITH_CONFIRMED_TASK_SPEC",
  "input_glob": "*",
  "start_item": null,
  "dataset_suffix": "",
  "review_manifest": "manifest.json",
  "decisions_file": "decisions.json",
  "commands": {
    "prepare_review": [
      "REPLACE_WITH_ADAPTER_COMMAND",
      "--input",
      "{input}",
      "--output",
      "{review_dir}",
      "--task-spec",
      "{task_spec}"
    ],
    "export_dataset": [
      "REPLACE_WITH_EXPORT_COMMAND",
      "--input",
      "{input}",
      "--decisions",
      "{decisions}",
      "--output",
      "{dataset_dir}"
    ],
    "run_validation": [
      "REPLACE_WITH_VALIDATOR_COMMAND",
      "{dataset_dir}"
    ]
  },
  "checks": [
    {
      "path": "meta/verification.json",
      "field": "status",
      "expected": "PASS",
      "stage": "internal"
    },
    {
      "path": "meta/official_validation.json",
      "field": "status",
      "expected": "PASS",
      "stage": "official"
    }
  ]
}
